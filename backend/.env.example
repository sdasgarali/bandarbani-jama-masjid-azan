# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL used to build absolute audio URLs when needed (no trailing slash)
PUBLIC_BASE_URL=http://localhost:4000

# ─── Database (MongoDB Atlas) ────────────────────────────────────────────────
# SRV connection string. A replica set is required for Prisma transactions
# (Atlas clusters are replica sets by default). Include the DB name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/azan?retryWrites=true&w=majority"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-string
# Access token TTL (~15m) and refresh token TTL (~30d). Uses vercel/ms syntax.
ACCESS_TTL=15m
REFRESH_TTL=30d

# ─── Seed admin ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in dev.
CORS_ORIGINS=http://localhost:3000

# ─── Audio upload ────────────────────────────────────────────────────────────
MAX_AUDIO_MB=10
UPLOAD_DIR=uploads

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Provide EITHER the raw JSON of a service account, OR a path to the JSON file.
# If neither is set, FCM sends are no-op'd (app still runs) and a warning is logged.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Device inactivity threshold (minutes) for DeviceStatus derivation ────────
DEVICE_INACTIVE_MINUTES=1440
