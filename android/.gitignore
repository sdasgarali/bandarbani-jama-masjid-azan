*.log
.DS_Store

# Android Studio / IntelliJ
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Keystore files — never commit signing material
*.jks
*.keystore
# Release signing config (paths + passwords) — commit keystore.properties.example instead
keystore.properties

# Firebase — real config must never be committed (use google-services.json.example)
google-services.json
app/google-services.json

# Version control
*.orig
