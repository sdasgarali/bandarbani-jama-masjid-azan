# Release signing configuration for a shareable/sideloadable APK.
#
# Copy this file to `keystore.properties` (same android/ root) and fill in real values.
# `keystore.properties` and the *.jks / *.keystore files are gitignored — NEVER commit them.
#
# Generate a keystore first (from the android/ directory):
#   keytool -genkeypair -v -keystore azan-release.jks -alias azan \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile     : path to the keystore file. Relative paths resolve against the app/ module
#                 directory (where build.gradle.kts lives), so "../azan-release.jks" points at
#                 android/azan-release.jks. An absolute path also works.
# storePassword : the keystore password you set during keytool -genkeypair.
# keyAlias      : the alias you passed to -alias (e.g. azan).
# keyPassword   : the key password (often the same as storePassword).

storeFile=../azan-release.jks
storePassword=changeme
keyAlias=azan
keyPassword=changeme
